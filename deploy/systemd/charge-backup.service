[Unit]
Description=Charge SQLite Backup
After=network-online.target

[Service]
Type=oneshot
# 与 charge-api 保持同属主 charge:charge，确保备份目录可读且 SQLite -wal/-shm 归属一致。
User=charge
Group=charge
EnvironmentFile=-/etc/charge-backup.env
ExecStart=/opt/charge-api/scripts/backup_db.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
LockPersonality=true
UMask=0077
ReadWritePaths=/var/lib/charge-api
