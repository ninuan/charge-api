[Unit]
Description=Charge SQLite Backup
After=network-online.target

[Service]
Type=oneshot
# 需要同时读取 charge 与 yyb 两个用户各自 0600 的数据库，因此以 root 运行；
# 用 ProtectSystem=strict 把可写面收敛到备份目录所在路径。
EnvironmentFile=-/etc/charge-backup.env
ExecStart=/opt/charge-api/scripts/backup_db.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
ReadWritePaths=/var/lib/charge-api
