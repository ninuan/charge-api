# Copy this file to .local/dev.env for local development.
# Values in your shell still take priority over this file.

YYB_BASE_URL=http://127.0.0.1:8000
YYB_API_SECRET=replace-with-the-same-secret-used-by-yyb-go

# Optional WxPusher integration. Create an app in WxPusher and copy its AppToken.
# AppToken is server-only: never expose it through NEXT_PUBLIC_* or commit a real value.
# WXPUSHER_APP_TOKEN=AT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Local tests may point at a loopback mock. Production should keep the official HTTPS default.
# WXPUSHER_BASE_URL=http://127.0.0.1:8089
# Production must use the public HTTPS origin, without a path or trailing slash.
# PUBLIC_BASE_URL=http://127.0.0.1:5173

# Optional Mocele overrides. Leave blank for defaults.
# MOCELE_BASE_URL=
# MOCELE_ORG=1
# MOCELE_OPENINDEX=7

# Local-only: the next refresh skips directly to YYB automatic credential recovery.
# Never use this in server environment variables.
# CHARGE_DEV_FORCE_AUTH_EXPIRED=true
