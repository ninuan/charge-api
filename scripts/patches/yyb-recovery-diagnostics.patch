+package protocol
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+type diagnosticTransport func(*http.Request) (*http.Response, error)
+
+func (f diagnosticTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestRefreshFailureIdentifiesTheFailingStage(t *testing.T) {
+	for _, stage := range []string{"refresh_credentials", "fetch_login_buffer"} {
+		t.Run(stage, func(t *testing.T) {
+			c := NewLoginBufferClient(time.Second)
+			calls := 0
+			c.httpClient.Transport = diagnosticTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				status, body := 503, "PRIVATE_BODY"
+				if stage == "fetch_login_buffer" && calls == 1 {
+					status, body = 200, `{"code":0,"user_info":{"access_token":"PRIVATE_ACCESS","refresh_token":"PRIVATE_REFRESH","expires_in":7200}}`
+				}
+				return &http.Response{StatusCode: status, Body: io.NopCloser(strings.NewReader(body)), Header: make(http.Header)}, nil
+			})
+			_, err := c.RefreshLoginBuffer(context.Background(), LoginBufferCredentials{OpenID: "PRIVATE_OPENID", RefreshToken: "OLD_REFRESH"})
+			if err == nil || !strings.HasPrefix(err.Error(), stage+":") {
+				t.Fatalf("wrong stage: %v", err)
+			}
+			expected := 1
+			if stage == "fetch_login_buffer" {
+				expected = 2
+			}
+			if calls != expected {
+				t.Fatalf("requests=%d", calls)
+			}
+		})
+	}
+}
