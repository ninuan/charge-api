+package httpapi
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log"
+	"net"
+	"regexp"
+	"strings"
+)
+
+var recoveryCodePattern = regexp.MustCompile(`(?:refresh|login_buffer) failed: code=(-?[0-9]{1,12})\b`)
+var recoveryHTTPPattern = regexp.MustCompile(`\bHTTP ([0-9]{3})\b`)
+
+// Never log the error itself: upstream bodies and URLs can carry credentials.
+// Only fixed labels and bounded numeric status fields leave this function.
+func recoveryFailureSummary(stage string, err error) string {
+	switch stage {
+	case "load_credentials", "refresh_login_buffer", "persist_credentials":
+	default:
+		stage = "unknown"
+	}
+	text := err.Error()
+	if strings.HasPrefix(text, "refresh_credentials:") {
+		stage = "refresh_credentials"
+	}
+	if strings.HasPrefix(text, "fetch_login_buffer:") {
+		stage = "fetch_login_buffer"
+	}
+	kind, code, httpStatus := "other", "none", "none"
+	switch {
+	case stage == "persist_credentials":
+		kind = "storage"
+	case strings.Contains(text, "missing refresh token"):
+		kind = "missing_refresh_token"
+	case stage == "load_credentials":
+		kind = "missing_credentials"
+	case errors.Is(err, context.Canceled):
+		kind = "cancelled"
+	case errors.Is(err, context.DeadlineExceeded):
+		kind = "timeout"
+	default:
+		var netErr net.Error
+		if errors.As(err, &netErr) {
+			if netErr.Timeout() {
+				kind = "timeout"
+			} else {
+				kind = "network"
+			}
+		}
+	}
+	if m := recoveryCodePattern.FindStringSubmatch(text); len(m) > 1 {
+		code = m[1]
+		kind = "upstream_rejected"
+	}
+	if m := recoveryHTTPPattern.FindStringSubmatch(text); len(m) > 1 {
+		httpStatus = m[1]
+		kind = "http_error"
+	}
+	if strings.Contains(text, "decode JSON") {
+		kind = "invalid_response"
+	}
+	if strings.Contains(text, "response missing access_token") || strings.Contains(text, "login_buffer response is empty") {
+		kind = "incomplete_response"
+	}
+	return fmt.Sprintf("yyb_recovery stage=%s kind=%s upstream_code=%s http_status=%s", stage, kind, code, httpStatus)
+}
+
+func logRecoveryFailure(stage string, err error) {
+	log.Print(recoveryFailureSummary(stage, err))
+}
