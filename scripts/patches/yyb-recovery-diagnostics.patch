+package httpapi
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestRecoveryDiagnosticsRevealStageWithoutCredentials(t *testing.T) {
+	for _, tc := range []struct {
+		stage string
+		err   error
+		want  string
+	}{
+		{"refresh_login_buffer", errors.New("refresh_credentials: refresh failed: code=40101 msg=SECRET_TOKEN"), "stage=refresh_credentials kind=upstream_rejected upstream_code=40101"},
+		{"refresh_login_buffer", errors.New("fetch_login_buffer: HTTP 503: SECRET_BODY"), "stage=fetch_login_buffer kind=http_error upstream_code=none http_status=503"},
+		{"refresh_login_buffer", fmt.Errorf("refresh_credentials: %w", context.DeadlineExceeded), "kind=timeout"},
+		{"refresh_login_buffer", errors.New("refresh_credentials: missing refresh token"), "kind=missing_refresh_token"},
+		{"refresh_login_buffer", errors.New("fetch_login_buffer: decode JSON: SECRET_BODY"), "kind=invalid_response"},
+		{"persist_credentials", errors.New("SECRET_DATABASE"), "stage=persist_credentials kind=storage"},
+		{"SECRET_STAGE", errors.New("SECRET_ERROR"), "stage=unknown kind=other"},
+	} {
+		got := recoveryFailureSummary(tc.stage, tc.err)
+		if !strings.Contains(got, tc.want) {
+			t.Errorf("got %q want %q", got, tc.want)
+		}
+		if strings.Contains(got, "SECRET") {
+			t.Fatalf("sensitive material escaped: %s", got)
+		}
+	}
+}
