+package httpapi
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+	"yyb_go/internal/protocol"
+	"yyb_go/internal/store"
+)
+
+type recoveryFakeClient struct {
+	refreshes, fetches int
+	fetchErr           error
+	used               []string
+	onRefresh          func()
+}
+
+func (c *recoveryFakeClient) RefreshCredentials(ctx context.Context, old protocol.LoginBufferCredentials) (protocol.LoginBufferCredentials, error) {
+	c.refreshes++
+	c.used = append(c.used, old.AccessToken)
+	if c.onRefresh != nil {
+		c.onRefresh()
+	}
+	old.AccessToken = "new-access"
+	old.RefreshToken = "new-refresh"
+	old.ExpiresAt = time.Now().Add(time.Hour).Unix()
+	return old, nil
+}
+func (c *recoveryFakeClient) FetchLoginBuffer(ctx context.Context, creds protocol.LoginBufferCredentials) (string, error) {
+	c.fetches++
+	if creds.AccessToken != "new-access" {
+		return "", errors.New("stale token used")
+	}
+	return "new-buffer", c.fetchErr
+}
+
+type recoveryFakeStore struct {
+	saves          int
+	failSave       int
+	failStatus     bool
+	creds          map[string]any
+	buffer, status string
+	canceledSave   bool
+}
+
+func (s *recoveryFakeStore) SetAccountCredential(ctx context.Context, id int64, buffer string, creds map[string]any) error {
+	s.saves++
+	s.canceledSave = ctx.Err() != nil
+	if s.saves == s.failSave {
+		return errors.New("storage unavailable")
+	}
+	s.creds = creds
+	s.buffer = buffer
+	return nil
+}
+func (s *recoveryFakeStore) SetAccountStatus(ctx context.Context, id int64, status string) error {
+	if s.failStatus {
+		return errors.New("storage unavailable")
+	}
+	s.status = status
+	return nil
+}
+func recoveryTestAccount() *store.WechatAccount {
+	return &store.WechatAccount{ID: 1, OpenID: "test-id", LoginBuffer: "old-buffer", Credentials: protocol.LoginBufferCredentials{OpenID: "test-id", AccessToken: "old-access", RefreshToken: "old-refresh"}.ToMap()}
+}
+func TestRecoveryPersistsBeforeFetchAndReusesAfterFailure(t *testing.T) {
+	acc := recoveryTestAccount()
+	db := &recoveryFakeStore{}
+	c := &recoveryFakeClient{fetchErr: errors.New("login_buffer failed: code=-101 msg=private")}
+	if got := recoverAccountCredentials(context.Background(), acc, c, db); got != "recovery_failed" {
+		t.Fatal(got)
+	}
+	if db.creds["accesstoken"] != "new-access" || db.creds["refreshtoken"] != "new-refresh" || db.buffer != "old-buffer" || db.creds["login_buffer_pending"] != true {
+		t.Fatal("rotated credentials were lost")
+	}
+	acc.Credentials = db.creds
+	c.fetchErr = nil
+	if got := recoverAccountCredentials(context.Background(), acc, c, db); got != "alive" {
+		t.Fatal(got)
+	}
+	if c.refreshes != 1 || c.fetches != 2 || db.buffer != "new-buffer" || db.creds["login_buffer_pending"] != nil {
+		t.Fatal("retry did not reuse pending credentials")
+	}
+}
+func TestRecoveryStorageFailuresNeverReportAlive(t *testing.T) {
+	for _, stage := range []string{"first-save", "final-save", "status"} {
+		t.Run(stage, func(t *testing.T) {
+			db := &recoveryFakeStore{}
+			c := &recoveryFakeClient{}
+			switch stage {
+			case "first-save":
+				db.failSave = 1
+			case "final-save":
+				db.failSave = 2
+			case "status":
+				db.failStatus = true
+			}
+			if recoverAccountCredentials(context.Background(), recoveryTestAccount(), c, db) != "recovery_failed" {
+				t.Fatal("false success")
+			}
+			if stage == "first-save" && c.fetches != 0 {
+				t.Fatal("continued before persistence")
+			}
+		})
+	}
+}
+func TestRecoverySavesRotatedCredentialsAfterCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &recoveryFakeClient{onRefresh: cancel, fetchErr: context.Canceled}
+	db := &recoveryFakeStore{}
+	recoverAccountCredentials(ctx, recoveryTestAccount(), c, db)
+	if db.canceledSave || db.creds["refreshtoken"] != "new-refresh" {
+		t.Fatal("cancellation discarded rotated credentials")
+	}
+}
+func TestRecoveryReloadsInsideAccountLockAndPersistsAcrossReopen(t *testing.T) {
+	dir := t.TempDir()
+	cfg := Config{ResourceRoot: dir, RequestTimeout: time.Second}
+	app, err := NewApp(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	acc, err := app.db.UpsertAccount(context.Background(), "test-id", "old-buffer", nil, nil, nil, nil, recoveryTestAccount().Credentials, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &recoveryFakeClient{fetchErr: errors.New("login_buffer failed: code=-101")}
+	app.recoveryClient = c
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if app.refreshLiveness(context.Background(), acc) != "recovery_failed" {
+				t.Error("wrong status")
+			}
+		}()
+	}
+	wg.Wait()
+	if c.refreshes != 1 || c.fetches != 4 {
+		t.Fatalf("refreshes=%d fetches=%d", c.refreshes, c.fetches)
+	}
+	app.Close()
+	app, err = NewApp(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer app.Close()
+	c = &recoveryFakeClient{}
+	app.recoveryClient = c
+	if app.refreshLiveness(context.Background(), acc) != "alive" || c.refreshes != 0 {
+		t.Fatal("reopened recovery lost rotated token")
+	}
+}
