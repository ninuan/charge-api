+package httpapi
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"hash/fnv"
+	"sync"
+	"time"
+	"yyb_go/internal/protocol"
+	"yyb_go/internal/store"
+)
+
+type loginRecoveryClient interface {
+	RefreshCredentials(context.Context, protocol.LoginBufferCredentials) (protocol.LoginBufferCredentials, error)
+	FetchLoginBuffer(context.Context, protocol.LoginBufferCredentials) (string, error)
+}
+type recoveryStore interface {
+	SetAccountCredential(context.Context, int64, string, map[string]any) error
+	SetAccountStatus(context.Context, int64, string) error
+}
+
+// Bounded striped locks serialize recovery and scan writes for the same identity.
+func (a *App) accountRecoveryLock(openid string) *sync.Mutex {
+	h := fnv.New32a()
+	_, _ = h.Write([]byte(openid))
+	return &a.recoveryLocks[h.Sum32()%uint32(len(a.recoveryLocks))]
+}
+
+func recoverAccountCredentials(ctx context.Context, acc *store.WechatAccount, client loginRecoveryClient, db recoveryStore) string {
+	fail := func(stage string, err error) string {
+		logRecoveryFailure(stage, err)
+		if e := db.SetAccountStatus(ctx, acc.ID, "recovery_failed"); e != nil {
+			logRecoveryFailure("persist_credentials", e)
+		}
+		return "recovery_failed"
+	}
+	if acc.Credentials == nil {
+		logRecoveryFailure("load_credentials", errors.New("missing credentials"))
+		if err := db.SetAccountStatus(ctx, acc.ID, "unknown"); err != nil {
+			return fail("persist_credentials", err)
+		}
+		return "unknown"
+	}
+	creds := protocol.CredentialsFromMap(acc.Credentials)
+	pending, _ := acc.Credentials["login_buffer_pending"].(bool)
+	// A failed second step must retry with the already persisted rotated token.
+	if !pending || creds.AccessToken == "" || creds.Expired(30*time.Second) {
+		fresh, err := client.RefreshCredentials(ctx, creds)
+		if err != nil {
+			return fail("refresh_login_buffer", fmt.Errorf("refresh_credentials: %w", err))
+		}
+		creds = fresh
+		values := creds.ToMap()
+		values["login_buffer_pending"] = true
+		// Retain the old buffer, but do not expose alive until a new one is obtained.
+		// Request cancellation after upstream rotation must not discard the new token.
+		saveCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+		err = db.SetAccountCredential(saveCtx, acc.ID, acc.LoginBuffer, values)
+		cancel()
+		if err != nil {
+			return fail("persist_credentials", err)
+		}
+	}
+	buffer, err := client.FetchLoginBuffer(ctx, creds)
+	if err != nil {
+		return fail("refresh_login_buffer", fmt.Errorf("fetch_login_buffer: %w", err))
+	}
+	if buffer == "" {
+		return fail("refresh_login_buffer", errors.New("fetch_login_buffer: login_buffer response is empty"))
+	}
+	if err := db.SetAccountCredential(ctx, acc.ID, buffer, creds.ToMap()); err != nil {
+		return fail("persist_credentials", err)
+	}
+	if err := db.SetAccountStatus(ctx, acc.ID, "alive"); err != nil {
+		return fail("persist_credentials", err)
+	}
+	return "alive"
+}
